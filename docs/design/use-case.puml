@startuml
left to right direction
skinparam packageStyle rectangle

actor Customer
actor Administrator
actor Agent
actor Biller

rectangle "PayLink System" {
    usecase "Register Account" as UC1
    usecase "Upgrade Verification Level" as UC2
    usecase "View Wallet Balance\nand Transaction History" as UC3
    usecase "Top Up Wallet" as UC4
    usecase "Manage Billers\nand Services" as UC5
    usecase "View Billers and\nRequired Input Fields" as UC6
    usecase "Run Bill Inquiry\n(View Amount, Fee and Total)" as UC7
    usecase "Pay Bill from Wallet" as UC8
}

Customer -- UC1
Customer -- UC2
Customer -- UC3
Customer -- UC4
Agent -- UC4
Administrator -- UC5
Customer -- UC6
Customer -- UC7
Biller -- UC7
Customer -- UC8
Biller -- UC8

note right of UC4
  Top-up channels:
  - Simulated card
  - Agent cash

  FR-5 applies to wallet balance changes:
  each change creates a ledger entry,
  and balances are calculated from
  ledger entries.
end note

@enduml
