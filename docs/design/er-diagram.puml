@startuml er-diagram
' PayLink - Entity-Relationship Diagram (Phase 1) - Owner: Student 4 (Quality & DevOps Lead)
' 12 relational tables (exceeds minimum 10 tables requirement in Brief Section 3.4).
skinparam shadowing false
skinparam defaultFontName Arial
skinparam entity {
  BackgroundColor #E8F5EE
  BorderColor #2E7D5B
  ArrowColor #455A64
  FontSize 12
}

title PayLink - Database ER Diagram (PostgreSQL)

entity "customers" as customers {
  * id : UUID <<PK>>
  --
  * phone_number : VARCHAR(20) <<UNIQUE>>
  * full_name : VARCHAR(120)
  * password_hash : VARCHAR(255)
  * role : VARCHAR(20)
  * verification_level : VARCHAR(20)
  * status : VARCHAR(20)
  blocked_until : TIMESTAMP
  * created_at : TIMESTAMP
}

entity "agents" as agents {
  * id : UUID <<PK>>
  --
  * customer_id : UUID <<FK, UNIQUE>>
  * terminal_code : VARCHAR(40) <<UNIQUE>>
  * commission_rate : DECIMAL(5,4)
  * is_active : BOOLEAN
  * created_at : TIMESTAMP
}

entity "wallets" as wallets {
  * id : UUID <<PK>>
  --
  * customer_id : UUID <<FK, UNIQUE>>
  * currency : CHAR(3)
  * available_balance : DECIMAL(12,2)
  * held_balance : DECIMAL(12,2)
  * version : INT
  * updated_at : TIMESTAMP
}

entity "ledger_entries" as ledger_entries {
  * id : UUID <<PK>>
  --
  * wallet_id : UUID <<FK>>
  payment_id : UUID <<FK>>
  * entry_type : VARCHAR(30)
  * bucket : VARCHAR(20)
  * amount : DECIMAL(12,2)
  * reference : VARCHAR(64)
  * created_at : TIMESTAMP
}

entity "billers" as billers {
  * id : UUID <<PK>>
  --
  * code : VARCHAR(30) <<UNIQUE>>
  * name : VARCHAR(100)
  * protocol : VARCHAR(30)
  * adapter_key : VARCHAR(50)
  * is_active : BOOLEAN
  promo_start : DATE
  promo_end : DATE
  * created_at : TIMESTAMP
}

entity "biller_services" as biller_services {
  * id : UUID <<PK>>
  --
  * biller_id : UUID <<FK>>
  * service_type : VARCHAR(40)
  * required_fields : JSONB
  * min_amount : DECIMAL(12,2)
  * max_amount : DECIMAL(12,2)
  * fee_type : VARCHAR(20)
  * fee_config : JSONB
  * is_active : BOOLEAN
}

entity "payments" as payments {
  * id : UUID <<PK>>
  --
  * reference : VARCHAR(64) <<UNIQUE>>
  * customer_id : UUID <<FK>>
  * idempotency_key : VARCHAR(100)
  agent_id : UUID <<FK>>
  * biller_service_id : UUID <<FK>>
  * account_identifier : VARCHAR(80)
  * bill_amount : DECIMAL(12,2)
  * service_fee : DECIMAL(12,2)
  * agent_commission : DECIMAL(12,2)
  * total_amount : DECIMAL(12,2)
  * state : VARCHAR(20)
  biller_tx_id : VARCHAR(100)
  failure_reason : VARCHAR(255)
  * retry_count : INT
  * created_at : TIMESTAMP
  * updated_at : TIMESTAMP
}

entity "payment_state_history" as payment_state_history {
  * id : UUID <<PK>>
  --
  * payment_id : UUID <<FK>>
  old_state : VARCHAR(20)
  * new_state : VARCHAR(20)
  * event : VARCHAR(50)
  reason : VARCHAR(255)
  * created_at : TIMESTAMP
}

entity "notifications" as notifications {
  * id : UUID <<PK>>
  --
  * payment_id : UUID <<FK>>
  * customer_id : UUID <<FK>>
  * channel : VARCHAR(20)
  * status : VARCHAR(20)
  * retry_count : INT
  last_error : TEXT
  * created_at : TIMESTAMP
  delivered_at : TIMESTAMP
}

entity "reconciliation_records" as reconciliation_records {
  * id : UUID <<PK>>
  --
  * biller_id : UUID <<FK>>
  * settlement_date : DATE
  * payment_reference : VARCHAR(64)
  paylink_state : VARCHAR(20)
  * biller_status : VARCHAR(30)
  paylink_amount : DECIMAL(12,2)
  * biller_amount : DECIMAL(12,2)
  discrepancy_type : VARCHAR(50)
  * resolved : BOOLEAN
  * created_at : TIMESTAMP
}

entity "refund_requests" as refund_requests {
  * id : UUID <<PK>>
  --
  * payment_id : UUID <<FK, UNIQUE>>
  * requested_by : UUID <<FK>>
  approved_by : UUID <<FK>>
  * status : VARCHAR(20)
  * reason : TEXT
  * created_at : TIMESTAMP
  resolved_at : TIMESTAMP
}

entity "audit_logs" as audit_logs {
  * id : UUID <<PK>>
  --
  * actor_id : UUID
  * actor_role : VARCHAR(20)
  * action_type : VARCHAR(50)
  * entity_type : VARCHAR(50)
  * entity_id : UUID
  old_value : TEXT
  new_value : TEXT
  * reason : TEXT
  * created_at : TIMESTAMP
}

customers ||--o| agents : "is_agent"
customers ||--|| wallets : "has"
wallets ||--o{ ledger_entries : "records"
customers ||--o{ payments : "makes"
agents ||--o{ payments : "processes"
billers ||--|{ biller_services : "provides"
biller_services ||--o{ payments : "paid_via"
payments ||--o{ ledger_entries : "creates"
payments ||--|{ payment_state_history : "logs"
payments ||--o{ notifications : "sends"
payments ||--o| refund_requests : "has_refund"
billers ||--o{ reconciliation_records : "settled_in"
@enduml